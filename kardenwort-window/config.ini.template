[Paths]
; [CANONICAL] AutoHotkey is restricted to OS tray lifecycle control and hotkey text redirection to the browser/Controller.
; Native AHK GUI window hosting, .update.js file-watcher polling, and child window cascading are [DEPRECATED].
DeskPythonPath = ../20260629183335-kardenwort-desk/venv/Scripts/python.exe
DeskScriptPath = ../20260629183335-kardenwort-desk/kardenwort_desk.py

[Settings]
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [settings] default_language
; Kept below as fallback if backend config is missing
DefaultLanguage = en
; [DEPRECATED] Legacy file-watcher interval for native AHK GUI (.update.js polling). Canonical mode uses browser SSE.
FileWatcherIntervalMs = 1000
MultiTapTimeout = 300
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [rendering] or [ui] default_zoom
DefaultZoom = 150
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [ui] theme
Theme = dark
; Set to 1 to auto-reload UI when backend TSV changes, or 0 to show an Update button instead
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [rendering] auto_inject_updates
AutoUpdate = 0
; Maximum number of seconds to suppress the Update button while waiting for a background task to finish saving its Javascript update payload.
; [DEPRECATED] Legacy .update.js grace period for native AHK GUI.
AutoInjectGracePeriodSec = 10
; Maximum age difference (in seconds) between the TSV file and the Javascript update payload to consider them part of the same background update.
; [DEPRECATED] Legacy .update.js file-age threshold for native AHK GUI.
AutoInjectMaxFileAgeDiffSec = 30
; Set to 1 to show information windows (e.g. successful export), or 0 to hide them
; Set to 1 to enable the hover-highlight MVP overlay, or 0 to disable it
HoverHighlightMvp = 1
; Number of bookmarks to keep in rotation ring for click-to-pin
HoverHighlightMvpBookmarks = 3
; Set to 1 to enable distinct, persistent rainbow colors for pinned bookmarks
HoverHighlightMvpRainbow = 1
; Maximum source-word index distance allowed between parts of a split/separable verb construct
; SplitGapLimit = 60
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [ui] auto_save_on_edit
AutoSaveOnEdit = 0
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [ui] auto_save_on_close
AutoSaveOnClose = 1
; Set to 1 to close all single-sentence child windows when closing the parent window, or 0 to keep them open
; [DEPRECATED] Legacy multi_window child window lifecycle setting. Canonical mode uses delivery_mode = container.
CloseDescendantsOnParentClose = 1
; Set to 1 to automatically close existing window when launching new text without prompting, or 0 to prompt
; [DEPRECATED] Legacy native AHK GUI window prompt setting.
AutoCloseOnNewLaunch = 0
; Set to 1 to cascade restored batch windows diagonally, or 0 to stack cleanly at base position
; [DEPRECATED] Legacy multi_window cascading setting. Canonical mode uses delivery_mode = container.
CascadeBatchWindows = 1

[Hotkey]
TapSingleMode = single
TapDoubleMode = multi
key_toggle_pointer = Alt

[Highlight]
OrdinaryColor = #ffd700
PairedColor = #9370db

[Languages]
en = English
de = German

[Window]
; [DEPRECATED] Native AHK GUI window geometry is deprecated; canonical UI host is launch_in_browser = true in kardenwort-desk/config.ini.
; [DEPRECATED] Canonical location is kardenwort-desk/config.ini [ui] launch_in_browser
LaunchInBrowser = 0
X = Center
Y = 36
Width = 892
Height = 592
